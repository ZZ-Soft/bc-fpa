{
  "al.enableCodeAnalysis": true,
  "al.codeAnalyzers": [
    "${CodeCop}",
    "${UICop}",
    "${AppSourceCop}"
  ],
  "al.enableCodeActions": true,
  "al.packageCachePath": "./.alpackages",
  "editor.formatOnSave": true,
  "files.encoding": "utf8bom",
  "files.exclude": {
    "**/.alcache": true,
    "**/.alpackages": true,
    "**/.snapshots": true
  }
}
